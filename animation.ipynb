# =========================================================
# SELECT STATES
# =========================================================

states = experiments[experiment]

# =========================================================
# CREATE FIGURE
# =========================================================

fig, ax = plt.subplots(figsize=(6,6))

frames = []

# =========================================================
# BUILD FRAMES
# =========================================================

for state in states:

    grid = np.array(
        [[int(bit) for bit in row] for row in state]
    )

    frame = ax.imshow(
        grid,
        animated=True,
        interpolation='nearest'
    )

    frames.append([frame])

# =========================================================
# CREATE ANIMATION
# =========================================================

ani = animation.ArtistAnimation(
    fig,
    frames,
    interval=700,
    blit=True,
    repeat_delay=1000
)

plt.close()

# =========================================================
# SAVE GIF
# =========================================================

gif_name = f"{experiment}_morphology.gif"

ani.save(
    gif_name,
    writer="pillow"
)

print(f"Saved GIF as: {gif_name}")

# =========================================================
# DISPLAY INLINE
# =========================================================

HTML(ani.to_jshtml())
